      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "One visual safetensors file stores the profiles; voice is in a separate optional audio file. Metadata records sources, dimensions and costs. Existing packages are never overwritten.\n\nConnect decoded_image to Preview Image; created_paths lists files.\n\nGeneration selects saved profiles without resizing or re-encoding. Earlier custom packages need recreation."
      ],
      "color": "#283d49",
      "bgcolor": "#172932"
